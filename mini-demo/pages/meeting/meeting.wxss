page {
  height: 100%;
  background: #0b0d12;
}

.empty {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: #f8faff;
}

.empty-title {
  color: #0f2243;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-desc {
  color: #64748b;
  font-size: 26rpx;
  margin-bottom: 40rpx;
}

.back-btn {
  min-width: 280rpx;
  color: #fff;
  background: linear-gradient(135deg, #3d8bff, #0052d9);
  border-radius: 16rpx;
  font-weight: 700;
}

.back-btn::after {
  border: none;
}
