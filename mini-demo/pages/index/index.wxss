page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  color: #1a1a1a;
  background:
    radial-gradient(920rpx 460rpx at 12% -8%, rgba(0, 110, 255, 0.16), transparent 58%),
    radial-gradient(720rpx 400rpx at 96% 4%, rgba(0, 180, 160, 0.12), transparent 52%),
    linear-gradient(180deg, #f8faff 0%, #eef2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 8rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.brand {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 36rpx;
  animation: rise 0.45s ease both;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #0f2243;
}

.brand-sub {
  font-size: 22rpx;
  color: #5e6d82;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 40rpx;
  animation: rise 0.5s ease both;
  animation-delay: 0.04s;
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: #006eff;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 750;
  color: #0f2243;
  letter-spacing: -0.03em;
  line-height: 1.2;
}

.hero-desc {
  font-size: 26rpx;
  color: #5e6d82;
  line-height: 1.55;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.nav-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border: 1rpx solid rgba(231, 234, 240, 0.95);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 56rpx rgba(15, 34, 67, 0.08);
  animation: rise 0.55s ease both;
}

.nav-call {
  animation-delay: 0.08s;
}

.nav-meet {
  animation-delay: 0.14s;
}

.nav-card-hover {
  opacity: 0.92;
  transform: translateY(2rpx);
}

.nav-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon-wrap.call {
  background: linear-gradient(145deg, #e8f2ff, #d6e8ff);
}

.nav-icon-wrap.meet {
  background: linear-gradient(145deg, #e6faf6, #d4f3ec);
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.call-icon {
  border: 6rpx solid #006eff;
  border-radius: 50%;
  box-sizing: border-box;
}

.call-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 18rpx;
  height: 10rpx;
  background: #006eff;
  border-radius: 4rpx;
  transform: rotate(-35deg);
}

.meet-icon {
  border: 5rpx solid #0d9f84;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.meet-icon::before,
.meet-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0d9f84;
  top: 8rpx;
}

.meet-icon::before {
  left: 6rpx;
}

.meet-icon::after {
  right: 6rpx;
}

.nav-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f2243;
}

.nav-desc {
  font-size: 24rpx;
  color: #5e6d82;
  line-height: 1.45;
}

.nav-arrow {
  font-size: 44rpx;
  color: #94a3b8;
  font-weight: 300;
  line-height: 1;
  padding-left: 4rpx;
}

.footnote {
  display: block;
  text-align: center;
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #94a3b8;
  animation: rise 0.6s ease both;
  animation-delay: 0.18s;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
