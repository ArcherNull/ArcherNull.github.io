<navigation-bar title="" back="{{false}}" color="#0f2243" background="transparent"></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list" enhanced show-scrollbar="{{false}}">
  <view class="page">
    <view class="brand">
      <text class="brand-name">腾讯视立方</text>
      <text class="brand-sub">音视频通话 · 选择进入方式</text>
    </view>

    <view class="hero">
      <text class="hero-kicker">START</text>
      <text class="hero-title">选择通话模式</text>
      <text class="hero-desc">一对一即时互通，或发起多人会议协作</text>
    </view>

    <view class="nav-list">
      <view class="nav-card nav-call" bindtap="onGoCall" hover-class="nav-card-hover">
        <view class="nav-icon-wrap call">
          <view class="nav-icon call-icon"></view>
        </view>
        <view class="nav-body">
          <text class="nav-title">1 对 1 视频语音通话</text>
          <text class="nav-desc">填写房间信息，或粘贴邀请链接进入</text>
        </view>
        <text class="nav-arrow">›</text>
      </view>

      <view class="nav-card nav-meet" bindtap="onGoMeeting" hover-class="nav-card-hover">
        <view class="nav-icon-wrap meet">
          <view class="nav-icon meet-icon"></view>
        </view>
        <view class="nav-body">
          <text class="nav-title">多人视频会议</text>
          <text class="nav-desc">TUIRoomKit 多人音视频会议入会</text>
        </view>
        <text class="nav-arrow">›</text>
      </view>
    </view>

    <text class="footnote">进入后将在小程序 WebView 中加载对应 H5 页面</text>
  </view>
</scroll-view>
